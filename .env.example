# Example environment variables
# Copy this to .env and fill in your values

# OpenAI API Configuration
OPENAI_API_KEY=your_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Note: In the current client-side implementation, 
# the API key is entered through the UI and stored in browser local storage.
# This .env file is provided for future server-side implementations.
